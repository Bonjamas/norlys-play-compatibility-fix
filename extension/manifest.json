{
  "manifest_version": 3,
  "name": "Norlys Play Compatibility Fix",
  "version": "1.0.0",
  "description": "Unofficial compatibility fix for Norlys Play browser detection.",
  "homepage_url": "https://github.com/Bonjamas/norlys-play-compatibility-fix",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://norlysplay.dk/*",
    "https://*.norlysplay.dk/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://norlysplay.dk/*",
        "https://*.norlysplay.dk/*"
      ],
      "js": [
        "spoof.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
